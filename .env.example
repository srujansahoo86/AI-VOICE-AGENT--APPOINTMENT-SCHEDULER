# FastAPI Settings
PORT=8000
HOST=0.0.0.0

# Mock MCP Toggle
# Set to 'True' to run simulated logs instead of actual Google API connections.
# Set to 'False' once you configure your Google Service Account key.
USE_MOCK_MCP=True

# Google Cloud Service Account Credentials
# Paste your downloaded Google Service Account JSON content as a single-line string here:
GOOGLE_CALENDAR_CREDENTIALS={"type": "service_account", ...}

# Google Sheets Configuration
# The spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Calendar Configuration
# Target calendar. Use 'primary' or a specific calendar address shared with the Service Account.
CALENDAR_ID=primary

# Gmail Drafts Configuration
# The target user's email address to create drafts in (requires Gmail scope authorization).
GMAIL_USER_EMAIL=your_email@domain.com
